<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PMDM UT3 Ejercicios"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Ejercicio1Activity"
            android:exported="false" />
        <activity
            android:name=".Ejercicio2Activity"
            android:exported="false" />
        <activity
            android:name=".Ejercicio2DestinoActivity"
            android:exported="false" />
        <activity
            android:name=".Ejercicio3Activity"
            android:exported="false" />
        <activity
            android:name=".Ejercicio3Sub1Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Ejercicio3Sub2Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Ejercicio3Sub3Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Ejercicio4Activity"
            android:exported="false" />
        <activity
            android:name=".Ejercicio5Activity"
            android:exported="false" />
        <activity
            android:name=".Ejercicio6Activity"
            android:exported="false" />
    </application>

</manifest>