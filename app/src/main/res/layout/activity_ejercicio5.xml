<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Pantalla de visualización -->
    <TextView
        android:id="@+id/tvPantallaCalc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:background="@color/calc_display_bg"
        android:gravity="bottom|end"
        android:padding="20dp"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="44sp"
        android:textStyle="bold" />

    <!-- Teclado en TableLayout -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:stretchColumns="*">

        <!-- Fila 1: C (ocupa 3 columnas) y / -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnLimpiar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_span="3"
                android:backgroundTint="@color/calc_clear_bg"
                android:text="C"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnDiv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:backgroundTint="@color/calc_op_bg"
                android:text="/"
                android:textSize="22sp" />
        </TableRow>

        <!-- Fila 2: 7, 8, 9, * -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="7"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="8"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="9"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnMul"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:backgroundTint="@color/calc_op_bg"
                android:text="*"
                android:textSize="22sp" />
        </TableRow>

        <!-- Fila 3: 4, 5, 6, - -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="4"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="5"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="6"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnRes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:backgroundTint="@color/calc_op_bg"
                android:text="-"
                android:textSize="22sp" />
        </TableRow>

        <!-- Fila 4: 1, 2, 3, + -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="1"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="2"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="3"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnSum"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:backgroundTint="@color/calc_op_bg"
                android:text="+"
                android:textSize="22sp" />
        </TableRow>

        <!-- Fila 5: 0 (ocupa 2 columnas), ., = -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_span="2"
                android:text="0"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnPunto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="."
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnIgual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:backgroundTint="@color/calc_op_bg"
                android:text="="
                android:textSize="22sp" />
        </TableRow>

    </TableLayout>

</LinearLayout>